{
  "name": "UpscaleImage",
  "version": "0.9.0",
  "private": true,
  "scripts": {
    "android": "expo run:android",
    "lint": "eslint .",
    "start": "expo start --dev-client",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "build:android": "bash scripts/build-android.sh",
    "verify:assets": "python3 scripts/verify-assets.py",
    "test:native-core": "bash scripts/test-native-core.sh",
    "coverage:check": "python3 scripts/check-coverage.py",
    "test:coverage": "jest --runInBand --coverage",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@react-native-firebase/app": "26.4.0",
    "@react-native-firebase/crashlytics": "26.4.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "@shopify/react-native-skia": "2.14.0",
    "expo": "58.0.17",
    "expo-blur": "~58.0.5",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.14",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.16",
    "expo-linking": "~58.0.14",
    "expo-router": "58.0.25",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/eslint-config": "0.88.0",
    "@react-native/jest-preset": "0.88.0",
    "@react-native/metro-config": "0.88.0",
    "@react-native/typescript-config": "0.88.0",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "30.5.2",
    "jest-expo": "58.0.12",
    "prettier": "2.8.8",
    "react-test-renderer": "19.3.0",
    "test-renderer": "1.3.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.11.0"
  },
  "codegenConfig": {
    "name": "UpscaleSpec",
    "type": "modules",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "dev.kigya.pixora"
    },
    "ios": {
      "modulesProvider": {
        "NativeUpscale": "PixoraUpscale"
      }
    }
  },
  "reanimated": {
    "staticFeatureFlags": {
      "ANDROID_SYNCHRONOUSLY_UPDATE_UI_PROPS": true
    }
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5"
  },
  "main": "expo-router/entry"
}
