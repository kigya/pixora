<set xmlns:android="http://schemas.android.com/apk/res/android" android:ordering="together">
    <objectAnimator android:propertyName="scaleX" android:valueFrom="0.7" android:valueTo="1"
        android:valueType="floatType" android:duration="600" android:interpolator="@android:interpolator/fast_out_slow_in" />
    <objectAnimator android:propertyName="scaleY" android:valueFrom="0.7" android:valueTo="1"
        android:valueType="floatType" android:duration="600" android:interpolator="@android:interpolator/fast_out_slow_in" />
    <objectAnimator android:propertyName="rotation" android:valueFrom="-12" android:valueTo="0"
        android:valueType="floatType" android:duration="600" android:interpolator="@android:interpolator/fast_out_slow_in" />
</set>
